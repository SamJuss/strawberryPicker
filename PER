#### Performance Benchmark
```python
#!/usr/bin/env python3
# performance_benchmark.py

import time
import cv2
import numpy as np
from ultralytics import YOLO
import pickle

def benchmark_detection():
    """Benchmark detection model performance."""
    print("Benchmarking YOLOv11 Detection...")
    
    model = YOLO('model/weights/yolo11n_strawberry_detect_v3.pt')
    
    # Create test image
    test_image = np.random.randint(0, 255, (480, 640, 3), dtype=np.uint8)
    
    # Warm up
    for _ in range(5):
        model(test_image, verbose=False)
    
    # Benchmark
    times = []
    for _ in range(100):
        start = time.time()
        results = model(test_image, verbose=False)
        end = time.time()
        times.append((end - start) * 1000)  # Convert to ms
    
    avg_time = np.mean(times)
    fps = 1000 / avg_time
    
    print(f"Average inference time: {avg_time:.1f}ms")
    print(f"Achievable FPS: {fps:.1f}")
    print(f"Min time: {np.min(times):.1f}ms")
    print(f"Max time: {np.max(times):.1f}ms")
    
    return avg_time, fps

def benchmark_classification():
    """Benchmark classification model performance."""
    print("\\nBenchmarking Ripeness Classification...")
    
    with open('model/ripeness_classifier.pkl', 'rb') as f:
        classifier = pickle.load(f)
    
    # Create test data
    test_data = np.random.randint(0, 255, (100, 224*224*3), dtype=np.uint8)
    
    # Warm up
    classifier.predict(test_data[:5])
    
    # Benchmark
    times = []
    for i in range(100):
        start = time.time()
        prediction = classifier.predict(test_data[i:i+1])
        end = time.time()
        times.append((end - start) * 1000)
    
    avg_time = np.mean(times)
    
    print(f"Average classification time: {avg_time:.1f}ms")
    print(f"Min time: {np.min(times):.1f}ms")
    print(f"Max time: {np.max(times):.1f}ms")
    
    return avg_time

def main():
    """Run complete performance benchmark."""
    print("=== Strawberry Picker Performance Benchmark ===\\n")
    
    try:
        detect_time, fps = benchmark_detection()
        classify_time = benchmark_classification()
        
        total_time = detect_time + classify_time
        total_fps = 1000 / total_time
        
        print(f"\\n=== Summary ===")
        print(f"Detection: {detect_time:.1f}ms ({fps:.1f} FPS)")
        print(f"Classification: {classify_time:.1f}ms")
        print(f"Total: {total_time:.1f}ms ({total_fps:.1f} FPS)")
        
        # Performance assessment
        if total_fps >= 20:
            print("✅ Performance: EXCELLENT (≥20 FPS)")
        elif total_fps >= 15:
            print("✅ Performance: GOOD (≥15 FPS)")
        elif total_fps >= 10:
            print("⚠️  Performance: ACCEPTABLE (≥10 FPS)")
        else:
            print("❌ Performance: POOR (<10 FPS)")
            
    except Exception as e:
        print(f"Benchmark failed: {e}")

if __name__ == "__main__":
    main()
```

