#!/usr/bin/env python3
"""
Coordinate Transformation System for Strawberry Picker
Handles pixel-to-robot coordinate transformation with calibration support
"""

import numpy as np
import cv2
import json
import logging
from pathlib import Path
from typing import Tuple, List, Dict, Optional
from dataclasses import dataclass

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

@dataclass
class CameraCalibration:
    """Camera calibration parameters."""
    fx: float
    fy: float
    cx: float
    cy: float
    k1: float = 0.0
    k2: float = 0.0
    k3: float = 0.0
    p1: float = 0.0
    p2: float = 0.0
    
    def to_dict(self) -> Dict:
        """Convert to dictionary."""
        return {
            'fx': self.fx, 'fy': self.fy, 'cx': self.cx, 'cy': self.cy,
            'k1': self.k1, 'k2': self.k2, 'k3': self.k3, 'p1': self.p1, 'p2': self.p2
        }
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'CameraCalibration':
        """Create from dictionary."""
        return cls(**data)

@dataclass
class RobotCalibration:
    """Robot workspace calibration parameters."""
    # Camera to robot transformation matrix
    rotation_matrix: np.ndarray
    translation_vector: np.ndarray
    
    # Workspace bounds (in robot coordinates)
    x_min: float
    x_max: float
    y_min: float
    y_max: float
    z_min: float
    z_max: float
    
    # Depth scaling factor
    depth_scale: float = 1.0
    
    def to_dict(self) -> Dict:
        """Convert to dictionary."""
        return {
            'rotation_matrix': self.rotation_matrix.tolist(),
            'translation_vector': self.translation_vector.tolist(),
            'x_min': self.x_min, 'x_max': self.x_max,
            'y_min': self.y_min, 'y_max': self.y_max,
            'z_min': self.z_min, 'z_max': self.z_max,
            'depth_scale': self.depth_scale
        }
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'RobotCalibration':
        """Create from dictionary."""
        return cls(
            rotation_matrix=np.array(data['rotation_matrix']),
            translation_vector=np.array(data['translation_vector']),
            x_min=data['x_min'], x_max=data['x_max'],
            y_min=data['y_min'], y_max=data['y_max'],
            z_min=data['z_min'], z_max=data['z_max'],
            depth_scale=data.get('depth_scale', 1.0)
        )

class CoordinateTransformer:
    """Handles coordinate transformations between pixel and robot space."""
    
    def __init__(self, calibration_file: str = "calibration.json"):
        """Initialize coordinate transformer."""
        self.calibration_file = Path(calibration_file)
        self.camera_cal = None
        self.robot_cal = None
        self.load_calibration()
    
    def load_calibration(self):
        """Load calibration data from file."""
        try:
            if self.calibration_file.exists():
                with open(self.calibration_file, 'r') as f:
                    data = json.load(f)
                
                self.camera_cal = CameraCalibration.from_dict(data.get('camera', {}))
                self.robot_cal = RobotCalibration.from_dict(data.get('robot', {}))
                
                logger.info("Calibration data loaded successfully")
            else:
                logger.warning("Calibration file not found, using default parameters")
                self._create_default_calibration()
                
        except Exception as e:
            logger.error(f"Error loading calibration: {e}")
            self._create_default_calibration()
    
    def save_calibration(self):
        """Save calibration data to file."""
        try:
            data = {
                'camera': self.camera_cal.to_dict(),
                'robot': self.robot_cal.to_dict()
            }
            
            with open(self.calibration_file, 'w') as f:
                json.dump(data, f, indent=2)
            
            logger.info("Calibration data saved successfully")
            
        except Exception as e:
            logger.error(f"Error saving calibration: {e}")
    
    def _create_default_calibration(self):
        """Create default calibration parameters."""
        # Default camera calibration (approximate values)
        self.camera_cal = CameraCalibration(
            fx=800.0, fy=800.0,  # Focal lengths
            cx=320.0, cy=240.0,  # Principal point (center of 640x480 image)
            k1=0.1, k2=-0.1      # Basic distortion coefficients
        )
        
        # Default robot calibration
        self.robot_cal = RobotCalibration(
            rotation_matrix=np.eye(3),  # Identity matrix (no rotation)
            translation_vector=np.array([0.0, 0.0, 0.0]),  # No translation
            x_min=0, x_max=300,  # 30cm workspace
            y_min=0, y_max=200,  # 20cm workspace
            z_min=50, z_max=150, # 10cm height range
            depth_scale=1.0      # 1:1 depth scaling
        )
    
    def pixel_to_robot(self, pixel_x: float, pixel_y: float, depth: float = 100.0) -> Tuple[float, float, float]:
        """
        Transform pixel coordinates to robot coordinates.
        
        Args:
            pixel_x, pixel_y: Pixel coordinates in image
            depth: Depth in mm (default 100mm)
            
        Returns:
            Tuple of (robot_x, robot_y, robot_z) in mm
        """
        try:
            # Convert pixel to normalized camera coordinates
            norm_x = (pixel_x - self.camera_cal.cx) / self.camera_cal.fx
            norm_y = (pixel_y - self.camera_cal.cy) / self.camera_cal.fy
            
            # Apply depth scaling
            depth_scaled = depth * self.robot_cal.depth_scale
            
            # Create 3D point in camera coordinates
            camera_point = np.array([norm_x * depth_scaled, norm_y * depth_scaled, depth_scaled])
            
            # Transform to robot coordinates
            robot_point = self.robot_cal.rotation_matrix @ camera_point + self.robot_cal.translation_vector
            
            # Clamp to workspace bounds
            robot_x = np.clip(robot_point[0], self.robot_cal.x_min, self.robot_cal.x_max)
            robot_y = np.clip(robot_point[1], self.robot_cal.y_min, self.robot_cal.y_max)
            robot_z = np.clip(robot_point[2], self.robot_cal.z_min, self.robot_cal.z_max)
            
            return float(robot_x), float(robot_y), float(robot_z)
            
        except Exception as e:
            logger.error(f"Error in pixel to robot transformation: {e}")
            return 0.0, 0.0, 0.0
    
    def robot_to_pixel(self, robot_x: float, robot_y: float, robot_z: float) -> Tuple[float, float]:
        """
        Transform robot coordinates to pixel coordinates.
        
        Args:
            robot_x, robot_y, robot_z: Robot coordinates in mm
            
        Returns:
            Tuple of (pixel_x, pixel_y)
        """
        try:
            # Transform from robot to camera coordinates
            robot_point = np.array([robot_x, robot_y, robot_z])
            camera_point = self.robot_cal.rotation_matrix.T @ (robot_point - self.robot_cal.translation_vector)
            
            # Convert to pixel coordinates
            pixel_x = self.camera_cal.fx * (camera_point[0] / camera_point[2]) + self.camera_cal.cx
            pixel_y = self.camera_cal.fy * (camera_point[1] / camera_point[2]) + self.camera_cal.cy
            
            return float(pixel_x), float(pixel_y)
            
        except Exception as e:
            logger.error(f"Error in robot to pixel transformation: {e}")
            return 0.0, 0.0
    
    def estimate_depth_from_bbox(self, bbox: List[float]) -> float:
        """
        Estimate depth from bounding box size.
        
        Args:
            bbox: Bounding box [x1, y1, x2, y2]
            
        Returns:
            Estimated depth in mm
        """
        try:
            x1, y1, x2, y2 = bbox
            width = x2 - x1
            height = y2 - y1
            
            # Assume average strawberry diameter of 30mm
            strawberry_diameter = 30.0
            
            # Calculate depth using similar triangles
            focal_length = (self.camera_cal.fx + self.camera_cal.fy) / 2
            pixel_size = (width + height) / 2
            
            if pixel_size > 0:
                depth = (strawberry_diameter * focal_length) / pixel_size
                return max(50.0, min(200.0, depth))  # Clamp between 5cm and 20cm
            
            return 100.0  # Default depth
            
        except Exception as e:
            logger.error(f"Error estimating depth: {e}")
            return 100.0
    
    def calibrate_camera(self, image_points: List[List[float]], object_points: List[List[float]]) -> bool:
        """
        Calibrate camera using chessboard or similar pattern.
        
        Args:
            image_points: List of pixel coordinates [[x, y], ...]
            object_points: List of world coordinates [[X, Y, Z], ...]
            
        Returns:
            True if calibration successful
        """
        try:
            # Convert to numpy arrays
            image_points = np.array(image_points, dtype=np.float32)
            object_points = np.array(object_points, dtype=np.float32)
            
            # Perform camera calibration
            ret, camera_matrix, dist_coeffs, rvecs, tvecs = cv2.calibrateCamera(
                [object_points], [image_points], 
                (640, 480), None, None
            )
            
            if ret:
                # Update camera calibration
                self.camera_cal.fx = camera_matrix[0, 0]
                self.camera_cal.fy = camera_matrix[1, 1]
                self.camera_cal.cx = camera_matrix[0, 2]
                self.camera_cal.cy = camera_matrix[1, 2]
                
                # Update distortion coefficients
                if len(dist_coeffs[0]) >= 5:
                    self.camera_cal.k1, self.camera_cal.k2, self.camera_cal.p1, self.camera_cal.p2, self.camera_cal.k3 = dist_coeffs[0][:5]
                
                logger.info("Camera calibration successful")
                return True
            else:
                logger.error("Camera calibration failed")
                return False
                
        except Exception as e:
            logger.error(f"Error in camera calibration: {e}")
            return False
    
    def calibrate_robot(self, pixel_robot_pairs: List[Tuple[Tuple[float, float], Tuple[float, float, float]]]) -> bool:
        """
        Calibrate robot transformation using known correspondences.
        
        Args:
            pixel_robot_pairs: List of (pixel_coords, robot_coords) pairs
            
        Returns:
            True if calibration successful
        """
        try:
            if len(pixel_robot_pairs) < 4:
                logger.error("Need at least 4 points for robot calibration")
                return False
            
            # Extract pixel and robot coordinates
            pixel_coords = []
            robot_coords = []
            
            for pixel, robot in pixel_robot_pairs:
                pixel_coords.append([pixel[0], pixel[1], 1.0])  # Add homogeneous coordinate
                robot_coords.append([robot[0], robot[1], robot[2]])
            
            pixel_coords = np.array(pixel_coords)
            robot_coords = np.array(robot_coords)
            
            # Solve for transformation matrix using least squares
            # This is a simplified approach - in practice, you'd use more sophisticated methods
            transformation_matrix = np.linalg.lstsq(pixel_coords, robot_coords, rcond=None)[0]
            
            # Extract rotation and translation
            self.robot_cal.rotation_matrix = transformation_matrix[:3, :3]
            self.robot_cal.translation_vector = transformation_matrix[:3, 3]
            
            logger.info("Robot calibration successful")
            return True
            
        except Exception as e:
            logger.error(f"Error in robot calibration: {e}")
            return False
    
    def validate_calibration(self, test_points: List[Tuple[Tuple[float, float], Tuple[float, float, float]]]) -> Dict[str, float]:
        """
        Validate calibration accuracy using test points.
        
        Args:
            test_points: List of (pixel_coords, expected_robot_coords) pairs
            
        Returns:
            Dictionary with validation metrics
        """
        try:
            errors = []
            
            for pixel, expected_robot in test_points:
                predicted_robot = self.pixel_to_robot(pixel[0], pixel[1])
                error = np.linalg.norm(np.array(predicted_robot) - np.array(expected_robot))
                errors.append(error)
            
            errors = np.array(errors)
            
            return {
                'mean_error': float(np.mean(errors)),
                'max_error': float(np.max(errors)),
                'std_error': float(np.std(errors)),
                'rmse': float(np.sqrt(np.mean(errors**2)))
            }
            
        except Exception as e:
            logger.error(f"Error in validation: {e}")
            return {'mean_error': 999.9, 'max_error': 999.9, 'std_error': 999.9, 'rmse': 999.9}

def create_calibration_pattern():
    """Create a calibration pattern for camera calibration."""
    # Create a chessboard pattern
    pattern_size = (9, 6)  # 9x6 chessboard
    square_size = 25  # 25mm squares
    
    # Generate object points
    objp = np.zeros((pattern_size[0] * pattern_size[1], 3), np.float32)
    objp[:, :2] = np.mgrid[0:pattern_size[0], 0:pattern_size[1]].T.reshape(-1, 2)
    objp *= square_size
    
    return objp

def main():
    """Test coordinate transformation system."""
    transformer = CoordinateTransformer()
    
    # Test pixel to robot transformation
    print("Testing coordinate transformation...")
    
    # Test points
    test_pixels = [(320, 240), (100, 100), (500, 300)]
    
    for pixel_x, pixel_y in test_pixels:
        robot_coords = transformer.pixel_to_robot(pixel_x, pixel_y)
        print(f"Pixel ({pixel_x}, {pixel_y}) -> Robot {robot_coords}")
    
    # Test reverse transformation
    test_robots = [(100, 50, 100), (200, 100, 120)]
    
    for robot_x, robot_y, robot_z in test_robots:
        pixel_coords = transformer.robot_to_pixel(robot_x, robot_y, robot_z)
        print(f"Robot ({robot_x}, {robot_y}, {robot_z}) -> Pixel {pixel_coords}")
    
    # Save calibration
    transformer.save_calibration()
    print("Calibration saved to calibration.json")

if __name__ == "__main__":
    main()