class TestCoordinateTransformer(unittest.TestCase):
    """Test coordinate transformation functionality."""
    
    def setUp(self):
        """Set up test fixtures."""
        self.transformer = CoordinateTransformer()
        
        # Create temporary calibration file
        self.temp_cal_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)
        self.temp_cal_file.close()
        self.transformer.calibration_file = self.temp_cal_file.name
    
    def tearDown(self):
        """Clean up test fixtures."""
        if os.path.exists(self.temp_cal_file.name):
            os.unlink(self.temp_cal_file.name)
    
    def test_pixel_to_robot_transformation(self):
        """Test pixel to robot coordinate transformation."""
        # Test center pixel transformation
        robot_coords = self.transformer.pixel_to_robot(320, 240, 100.0)
        
        # Should return valid coordinates within workspace bounds
        self.assertIsInstance(robot_coords, tuple)
        self.assertEqual(len(robot_coords), 3)
        
        x, y, z = robot_coords
        self.assertGreaterEqual(x, self.transformer.robot_cal.x_min)
        self.assertLessEqual(x, self.transformer.robot_cal.x_max)
        self.assertGreaterEqual(y, self.transformer.robot_cal.y_min)
        self.assertLessEqual(y, self.transformer.robot_cal.y_max)
        self.assertGreaterEqual(z, self.transformer.robot_cal.z_min)
        self.assertLessEqual(z, self.transformer.robot_cal.z_max)
    
    def test_robot_to_pixel_transformation(self):
        """Test robot to pixel coordinate transformation."""
        # Test center robot position
        pixel_coords = self.transformer.robot_to_pixel(150, 100, 100)
        
        # Should return valid pixel coordinates
        self.assertIsInstance(pixel_coords, tuple)
        self.assertEqual(len(pixel_coords), 2)
        
        x, y = pixel_coords
        self.assertGreaterEqual(x, 0)
        self.assertLessEqual(x, 640)  # Assuming 640x480 camera
        self.assertGreaterEqual(y, 0)
        self.assertLessEqual(y, 480)
    
    def test_depth_estimation(self):
        """Test depth estimation from bounding box."""
        # Test with typical strawberry bounding box
        bbox = [100, 100, 150, 150]  # 50x50 pixel box
        depth = self.transformer.estimate_depth_from_bbox(bbox)
        
        # Should return reasonable depth value
        self.assertIsInstance(depth, float)
        self.assertGreater(depth, 0)
        self.assertLess(depth, 500)  # Reasonable upper bound
    
    def test_calibration_save_load(self):
        """Test calibration save and load functionality."""
        # Modify calibration
        original_fx = self.transformer.camera_cal.fx
        self.transformer.camera_cal.fx = 999.0
        
        # Save calibration
        self.transformer.save_calibration()
        
        # Create new transformer and load
        new_transformer = CoordinateTransformer(self.temp_cal_file.name)
        
        # Should have loaded the modified value
        self.assertEqual(new_transformer.camera_cal.fx, 999.0)
        
        # Restore original value
        self.transformer.camera_cal.fx = original_fx

class TestArduinoBridge(unittest.TestCase):
    """Test Arduino communication bridge."""
    
    def setUp(self):
        """Set up test fixtures."""
        # Mock serial connection
        self.mock_serial = Mock()
        self.mock_serial.is_open = True
        self.mock_serial.in_waiting = 0
        
        self.bridge = ArduinoBridge()
        self.bridge.connection = self.mock_serial
        self.bridge.is_connected = True
    
    def test_command_queuing(self):
        """Test command queuing functionality."""
        # Test queuing commands
        result1 = self.bridge.send_command("PING")
        result2 = self.bridge.send_command("MOVE,100,50,80")
        
        self.assertTrue(result1)
        self.assertTrue(result2)
        self.assertEqual(len(self.bridge.command_queue), 2)
    
    def test_status_tracking(self):
        """Test robot status tracking."""
        # Test initial status
        status = self.bridge.get_status()
        
        self.assertIn('position', status)
        self.assertIn('status', status)
        self.assertEqual(status['status'], 'idle')
        
        # Test status update
        self.bridge._handle_response("POSITION:100,50,80")
        status = self.bridge.get_status()
        
        self.assertEqual(status['position']['x'], 100)
        self.assertEqual(status['position']['y'], 50)
        self.assertEqual(status['position']['z'], 80)
    
    def test_emergency_stop(self):
        """Test emergency stop functionality."""
        # Test emergency stop
        self.bridge.emergency_stop()
        
        # Should queue ESTOP command
        self.assertIn("ESTOP", str(self.bridge.command_queue))
        self.assertEqual(self.bridge.robot_state['status'], 'emergency_stop')

