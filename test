class TestSystemIntegration(unittest.TestCase):
    """Test complete system integration."""
    
    def test_configuration_loading(self):
        """Test configuration file loading."""
        # Create test config
        test_config = {
            'detection': {
                'model_path': 'test_model.pt',
                'confidence_threshold': 0.5
            },
            'robot': {
                'workspace_bounds': {
                    'x_min': 0, 'x_max': 300,
                    'y_min': 0, 'y_max': 200
                }
            }
        }
        
        # Save test config
        temp_config = tempfile.NamedTemporaryFile(mode='w', suffix='.yaml', delete=False)
        json.dump(test_config, temp_config)
        temp_config.close()
        
        try:
            # Test loading
            from strawberry_picker_pipeline import StrawberryPickerPipeline
            pipeline = StrawberryPickerPipeline(temp_config.name)
            
            self.assertEqual(pipeline.config['detection']['model_path'], 'test_model.pt')
            self.assertEqual(pipeline.config['detection']['confidence_threshold'], 0.5)
            
        finally:
            os.unlink(temp_config.name)
    
    def test_error_handling(self):
        """Test error handling mechanisms."""
        # Test with invalid configuration
        from strawberry_picker_pipeline import StrawberryPickerPipeline
        
        # Should handle missing config gracefully
        try:
            pipeline = StrawberryPickerPipeline("nonexistent_config.yaml")
            # Should create default config
            self.assertIsNotNone(pipeline.config)
        except Exception as e:
            # Should not crash completely
            self.assertIsInstance(e, (FileNotFoundError, Exception))

class TestPerformanceBenchmarks(unittest.TestCase):
    """Test performance benchmarks."""
    
    def test_coordinate_transformation_speed(self):
        """Test coordinate transformation speed."""
        transformer = CoordinateTransformer()
        
        # Test transformation speed
        import time
        
        start_time = time.time()
        for _ in range(1000):
            transformer.pixel_to_robot(320, 240, 100.0)
        end_time = time.time()
        
        avg_time = (end_time - start_time) / 1000
        self.assertLess(avg_time, 0.001)  # Should be faster than 1ms per transformation
    
    def test_image_processing_speed(self):
        """Test image processing speed."""
        # Create test image
        test_image = np.random.randint(0, 255, (480, 640, 3), dtype=np.uint8)
        
        import time
        
        start_time = time.time()
        for _ in range(100):
            # Simulate basic image processing
            gray = cv2.cvtColor(test_image, cv2.COLOR_BGR2GRAY)
            edges = cv2.Canny(gray, 50, 150)
        end_time = time.time()
        
        avg_time = (end_time - start_time) / 100
        self.assertLess(avg_time, 0.1)  # Should be faster than 100ms per frame

