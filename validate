def test_coordinate_transformation():
    """Test coordinate transformation logic."""
    print("Testing coordinate transformation...")
    
    # Simulate camera calibration parameters
    fx, fy = 800.0, 800.0  # Focal lengths
    cx, cy = 320.0, 240.0  # Principal point
    
    # Simulate robot workspace bounds
    x_min, x_max = 0, 300
    y_min, y_max = 0, 200
    z_min, z_max = 50, 150
    
    def pixel_to_robot(pixel_x, pixel_y, depth=100.0):
        """Simple pixel to robot transformation."""
        # Convert pixel to normalized coordinates
        norm_x = (pixel_x - cx) / fx
        norm_y = (pixel_y - cy) / fy
        
        # Apply depth scaling
        robot_x = x_min + (norm_x + 0.5) * (x_max - x_min)
        robot_y = y_min + (norm_y + 0.5) * (y_max - y_min)
        robot_z = z_min + (depth - z_min) / (z_max - z_min) * (z_max - z_min) + z_min
        
        # Clamp to workspace bounds
        robot_x = max(x_min, min(x_max, robot_x))
        robot_y = max(y_min, min(y_max, robot_y))
        robot_z = max(z_min, min(z_max, robot_z))
        
        return robot_x, robot_y, robot_z
    
    # Test transformations
    test_pixels = [(320, 240), (100, 100), (500, 300)]
    
    for pixel_x, pixel_y in test_pixels:
        robot_coords = pixel_to_robot(pixel_x, pixel_y)
        print(f"  Pixel ({pixel_x}, {pixel_y}) -> Robot ({robot_coords[0]:.1f}, {robot_coords[1]:.1f}, {robot_coords[2]:.1f})")
    
    print("✅ Coordinate transformation test passed!")

def test_image_processing():
    """Test image processing capabilities."""
    print("\nTesting image processing...")
    
    # Create test image
    test_image = np.zeros((480, 640, 3), dtype=np.uint8)
    
    # Add some content
    cv2.rectangle(test_image, (100, 100), (200, 200), (0, 255, 0), 2)
    cv2.circle(test_image, (320, 240), 50, (255, 0, 0), -1)
    
    # Test basic operations
    gray = cv2.cvtColor(test_image, cv2.COLOR_BGR2GRAY)
    edges = cv2.Canny(gray, 50, 150)
    
    # Check results
    assert test_image.shape == (480, 640, 3), "Image shape incorrect"
    assert gray.shape == (480, 640), "Gray conversion failed"
    assert edges.shape == (480, 640), "Edge detection failed"
    
    print(f"  Original image: {test_image.shape}")
    print(f"  Gray image: {gray.shape}")
    print(f"  Edge image: {edges.shape}")
    print("✅ Image processing test passed!")

